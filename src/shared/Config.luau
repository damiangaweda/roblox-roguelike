-- Every tunable number of the game, in one place (AGENTS.md rule 3).
-- Distances are studs, times are seconds, angles in config are degrees.

local Templates = require("./Templates")
local Types = require("./Core/Types")

local function skill(
	id: string,
	name: string,
	shape: Types.SkillShape,
	fields: { [string]: any }
): Types.SkillConfig
	local base: Types.SkillConfig = {
		id = id,
		name = name,
		shape = shape,
		damage = 0,
		cooldownSeconds = 0,
		range = 0,
		radius = 0,
		width = 0,
		pierce = 0,
		jumps = 0,
		jumpRange = 0,
		coneDegrees = 0,
		speed = 0,
		knockback = 0,
		tags = {},
	}
	for key, value in fields do
		(base :: any)[key] = value
	end
	return base
end

local function perk(
	name: string,
	property: Types.Property,
	effect: { mul: number?, add: number? },
	maxStacks: number
): Types.PerkConfig
	return {
		name = name,
		property = property,
		mul = effect.mul,
		add = effect.add,
		maxStacks = maxStacks,
	}
end

